{
  "name": "chrome-extension-website-blocker",
  "version": "1.0.2",
  "description": "Website blocker",
  "main": "index.js",
  "scripts": {
    "watch": "npm run clean && webpack --config webpack/webpack.dev.js --watch",
    "build": "npm run typecheck && npm run clean && webpack --config webpack/webpack.prod.js",
    "clean": "rm -rf ./built",
    "test": "jest",
    "test:coverage": "jest --runInBand --no-watchman --coverage",
    "test:integration": "jest --runInBand --no-watchman --testPathPatterns=integration",
    "test:e2e": "npm run build && playwright test",
    "package:store": "npm run build && node scripts/create-store-package.cjs",
    "publish": "npm audit && npm run lint && npm run test:coverage && npm run test:e2e && node scripts/create-store-package.cjs",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "lint": "oxlint src e2e playwright.config.ts",
    "lint:fix": "oxlint src e2e playwright.config.ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janosvajda/chrome-extension-website-blocker.git"
  },
  "keywords": [
    "Website",
    "blocking",
    "Chrome",
    "website",
    "blocker",
    "block",
    "website"
  ],
  "author": "Janos Vajda",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/janosvajda/chrome-extension-website-blocker/issues"
  },
  "homepage": "https://github.com/janosvajda/chrome-extension-website-blocker#readme",
  "dependencies": {
    "@types/chrome": "0.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "copy-webpack-plugin": "14.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "oxlint": "1.79.0",
    "swc-loader": "0.2.7",
    "typescript": "7.0.2",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-merge": "6.0.1"
  }
}
