{
  "manifest_version": 3,
  "name": "Tiny Website Blocker",
  "description": "Stay focused with a simple, free and private website blocker. Set flexible schedules. No account, tracking or data collection.",
  "version": "1.0.10",
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage", "tabs", "activeTab", "contextMenus", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/website_blocker_icon_16x16.png",
    "32": "icons/website_blocker_icon_32x32.png",
    "48": "icons/website_blocker_icon_48x48.png",
    "128": "icons/website_blocker_icon_128x128.png"
  },
  "minimum_chrome_version": "92"
}
